{
  "name": "dsh-desktop-gui",
  "description": "A desktop (Electron) wrapper for the DeepSeek Harness browser GUI: launches the web backend, opens it in a native window, and tears it down on close.",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Zhen-WushuiLingchun",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.dsh.desktopgui",
    "productName": "DeepSeek Harness Desktop",
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
